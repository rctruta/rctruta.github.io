#!/bin/sh
set -e
ROOT="$(git rev-parse --show-toplevel)"
PY="$(command -v python3)"

# Personal contact details must never reach a public site. Runs first and
# unconditionally — it does not depend on anything outside this repository.
if ! "$PY" "$ROOT/tools/check_private.py"; then
  exit 1
fi

# The pages must match the data they were generated from. These assert on the
# built HTML, so they belong here rather than only in ./build.
if ! "$PY" "$ROOT/tools/test_tools.py" >/dev/null; then
  "$PY" "$ROOT/tools/test_tools.py" || true
  echo "  -> A page disagrees with its data. Run ./build." >&2; exit 1
fi

# Gates from ai-agent-utils. GATES.md there records why each exists and what
# incident produced it. The claim and privacy gates above predate that system
# and stay where they are; these are the two it added.
if [ -d "$ROOT/.gates" ]; then
  "$PY" "$ROOT/.gates/no_local_paths.py" --check || {
    echo "  -> A tracked file carries this machine's absolute path." >&2; exit 1; }
  "$PY" "$ROOT/.gates/no_hardcoding.py" --check || {
    echo "  -> Code restates a value data/ already holds." >&2; exit 1; }
fi

# Claims gate: numbers on the site must match their registered source.
CLAIMS="$HOME/claude-docs-allowed/Resume/.claims"
[ -x "$CLAIMS/verify.py" ] || exit 0
if ! "$PY" "$CLAIMS/verify.py" --check; then
  echo "  -> A fact on the site no longer matches its source." >&2; exit 1
fi
if ! "$PY" "$CLAIMS/scan.py" --check "$ROOT"; then
  echo "  -> A banned claim appears in the site. See .claims/FACTS.yaml." >&2; exit 1
fi
