#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! LC_ALL=C grep -q '[^[:space:]]' "$1"; then
  echo "Commit message must not be empty." >&2
  exit 1
fi
if [ ! -x node_modules/.bin/commitlint ]; then
  echo "commitlint is not installed. Run npm ci." >&2
  exit 1
fi
exec node_modules/.bin/commitlint --strict --edit "$1"
