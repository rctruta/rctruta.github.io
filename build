#!/bin/sh

set -e
cd "$(dirname "$0")"
if [ -x .venv/bin/python ]; then
  PYTHON="${PYTHON:-.venv/bin/python}"
else
  PYTHON="${PYTHON:-python3}"
fi

echo "validate source contracts"
"$PYTHON" tools/validate_site.py --sources-only

echo "1/10 work          <- data/work.yaml"
"$PYTHON" tools/build_work.py

echo "2/10 teaching      <- data/teaching.yaml"
"$PYTHON" tools/build_teaching.py

echo "3/10 speaking      <- data/appearances.yaml"
"$PYTHON" tools/build_speaking.py

echo "4/10 writing       <- data/writing.yaml"
"$PYTHON" tools/build_writing.py

echo "5/10 contact       <- data/contact.yaml + config.yaml"
"$PYTHON" tools/build_contact.py

echo "6/10 home          <- data/home.yaml + config.yaml"
"$PYTHON" tools/build_index.py

echo "7/10 rules doc     <- data/TAGS.yaml + data/appearances.yaml"
"$PYTHON" tools/build_rules_doc.py

echo "8/10 tag index     <- data/TAGS.yaml + content data"
"$PYTHON" tools/build_tags.py

echo "9/10 navigation    <- config.yaml / tools/build_nav.py"
"$PYTHON" tools/build_nav.py

echo "10/10 search       <- generated HTML pages"
"$PYTHON" tools/build_search.py

echo
echo "declared checks   <- .pre-commit-config.yaml"
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --all-files
else
  echo "  -> pre-commit is not installed. Run: pip install pre-commit" >&2
  exit 3
fi

"$PYTHON" tools/validate_site.py

echo "unit tests        <- tests/"
"$PYTHON" -m unittest discover -s tests -t .

echo
echo "Build complete. Review changes with: git status"
