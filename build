#!/bin/sh
# Rebuild everything the data drives, in the only order that is correct.
#
#     ./build
#
# Order matters. Page generators run before tag index and navigation,
# and search indexes the finished pages, so it runs last.
#
# Safe to run at any time. Every step is idempotent.

set -e
cd "$(dirname "$0")"
export PATH="/opt/homebrew/bin:$PATH"

echo "1/13 work          <- data/work.yaml"
python3 tools/build_work.py

echo "2/13 teaching      <- data/teaching.yaml"
python3 tools/build_teaching.py

echo "3/13 speaking      <- data/appearances.yaml"
python3 tools/build_speaking.py

echo "4/13 writing       <- data/writing.yaml"
python3 tools/build_writing.py

echo "5/13 contact       <- data/contact.yaml + config.yaml"
python3 tools/build_contact.py

echo "6/13 home          <- data/home.yaml + config.yaml + work.yaml + teaching.yaml"
python3 tools/build_index.py

echo "7/13 github readme <- the same data, projected for ~/Projects/rctruta"
python3 tools/build_github_readme.py

echo "8/13 rules doc     <- the kinds table, from the controlled vocabulary"
python3 tools/build_rules_doc.py

echo "9/13 tag index     <- data/TAGS.yaml + data/writing.yaml + data/work.yaml + data/teaching.yaml"
python3 tools/build_tags.py

echo "10/13 navigation    <- the NAV list in config.yaml / tools/build_nav.py"
python3 tools/build_nav.py

echo "11/13 figures      <- numbers in tools/lakehouse_chart.py and tools/malloy_chart.py"
python3 tools/lakehouse_chart.py
python3 tools/malloy_chart.py

echo "12/13 search       <- the finished pages"
python3 tools/build_search.py

if [ -f "tools/sync_template.py" ]; then
    echo "13/13 template sync <- tools/sync_template.py"
    python3 tools/sync_template.py
fi

echo
echo "unit tests     <- tools/test_tools.py, over the pages just generated"
python3 tools/test_tools.py

echo "Done. Review with: git diff --stat"
echo "Publish with:      git add -A && git commit -m '...' && git push"
