{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramonactruta.com/schemas/employment.schema.json",
  "title": "Portfolio Employment document",
  "description": "Contract for optional private employment data; no employment data is published.",
  "type": "object",
  "properties": {
    "tagline": {
      "type": "string",
      "default": ""
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "required": [
    "roles"
  ],
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "org": {
          "type": "string",
          "default": ""
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "default": "self"
        },
        "note": {
          "type": "string",
          "default": ""
        },
        "work_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": [
        "role",
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  }
}
