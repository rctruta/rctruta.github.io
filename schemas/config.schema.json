{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramonactruta.com/schemas/config.schema.json",
  "title": "Portfolio Config document",
  "description": "Authoritative structural contract; see docs/contracts.md for mandatory relationship constraints.",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "search_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "copyright_license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "copyright_license_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "contact_form": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "substack": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "substack_rss": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "github": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "linkedin": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "orcid": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "orcid_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "calendly": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "contact_form",
            "substack",
            "substack_rss",
            "github",
            "linkedin",
            "orcid",
            "orcid_id",
            "calendly"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "tagline",
        "description",
        "url",
        "image",
        "search_label",
        "copyright_license",
        "copyright_license_url",
        "author"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "href": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "href",
          "enabled"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "controlled_vocabulary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "controlled_vocabulary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "site",
    "navigation",
    "data"
  ],
  "additionalProperties": false
}
